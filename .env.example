# ==============================================================================
# EVENT MONEY TRACKER - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Flask Settings
FLASK_APP=wsgi.py
FLASK_ENV=development
SECRET_KEY=generate_a_strong_random_secret_key_here_for_sessions

# Database Configuration
# Local SQLite (default fallback): sqlite:///event_tracker.db
# PostgreSQL (Production on Render): postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///event_tracker.db

# Server & URL Settings
APP_BASE_URL=http://localhost:5000

# Google OAuth 2.0 & Google Drive API Configuration
# Obtain credentials from: https://console.cloud.google.com/apis/credentials
# Ensure Google Drive API is enabled and authorized redirect URI includes:
#   http://localhost:5000/auth/google/callback (for local dev)
#   https://<your-render-subdomain>.onrender.com/auth/google/callback (for production)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_DRIVE_FOLDER_NAME=EventMoneyTracker_Receipts

# Logging Level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=DEBUG
